DB_HOST=your_db_host
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=HitoAI
DB_PORT=3306
PORT=8080

# JWT: secreto para firmar tokens de sesión (OBLIGATORIO en producción, usar valor aleatorio largo)
JWT_SECRET=change_me_to_a_long_random_string
# Expiración del token (por defecto 8h)
JWT_EXPIRES_IN=8h

# Orígenes permitidos por CORS, separados por coma (ej: http://localhost:4200,https://hitoai.uni.cl)
CORS_ORIGIN=http://localhost:4200

OPENAI_API_KEY=your_openai_key
OPENAI_MODEL=gpt-5-mini
